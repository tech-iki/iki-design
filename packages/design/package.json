{
  "name": "@tech-iki/design",
  "version": "0.4.0",
  "description": "The IKI design system: colour tokens, status tones, control classes and shared components",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tech-iki/iki-design.git",
    "directory": "packages/design"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-icons.ts && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "dev": "node scripts/build-icons.ts && tsc -p tsconfig.build.json --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "jsdom": "^30.1.3",
    "lucide": "^1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0"
  }
}
